OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Leave unset for local SQLite. Render sets this automatically for the managed Postgres.
DATABASE_URL=

# Gmail SMTP for status-change email alerts (generate an App Password, not your real password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_TO_EMAIL=

# Deployed frontend origin, for CORS (not needed for local dev)
FRONTEND_ORIGIN=
